# Dockerfile.test-runner — Containerized E2E test client for Shieldoo Gate
#
# Contains ALL package managers needed to test every proxy adapter.
# All tool versions MUST be pinned (per CLAUDE.md).
#
# Build context: repository root (../../)
# Usage: docker compose -f tests/e2e-shell/docker-compose.e2e.yml up test-runner

# --- shdg CLI build stage (added by test_vuln_scan_shdg) ---
# We do NOT need the rest of internal/ — the shdg main package is Go-stdlib-only.
# We also do NOT git-stamp the binary (no .git in the build context); a hard-coded
# "e2e" value is sufficient for the smoke test.
#
# The `FROM golang:...` below is an ADR-010 Go-toolchain lockstep location —
# it compiles the `shdg` binary shipped into the e2e image. Keep it in
# lockstep with go.mod's `go` directive, docker/Dockerfile's `go-builder`
# stage, the three CI GO_VERSION values (.github/workflows/{ci,codeql,
# release}.yml), and — easy to miss — the SEPARATE ARG GO_VERSION/GO_SHA256
# tarball install further down in *this same file*, which is an independent
# toolchain that neither implies nor updates this one. Bump the tag AND the
# @sha256 digest together: Docker resolves `name:tag@digest` by digest, so
# editing only the tag silently keeps building the old, unpatched image with
# no checksum failure to catch it. See ADR-010 for the authoritative
# seven-location list.
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS shdg-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/shdg ./cmd/shdg
RUN CGO_ENABLED=0 go build \
        -ldflags "-X main.Version=e2e -X main.Commit=e2e" \
        -o /out/shdg ./cmd/shdg

FROM ubuntu:26.04@sha256:53958ec7b67c2c9355df922dd08dbf0360611f8c3cdb656875e81873db9ffdba

# Avoid interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Base utilities
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates=20260601~26.04.1 \
        curl=8.18.0-1ubuntu2.* \
        file=1:5.46-5build2 \
        jq=1.8.1-* \
        postgresql-client \
        unzip=6.0-29ubuntu* \
        git=1:2.53.0-1ubuntu* \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python — uv (pinned)
# ---------------------------------------------------------------------------
ARG UV_VERSION=0.6.0
RUN curl -LsSf "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-installer.sh" | \
    sh -s
ENV PATH="/root/.local/bin:${PATH}"

# Install Python via uv (pinned version)
ARG PYTHON_VERSION=3.12.8
RUN uv python install "${PYTHON_VERSION}"

# ---------------------------------------------------------------------------
# Node.js (pinned via NodeSource)
# ---------------------------------------------------------------------------
ARG NODE_MAJOR=20
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - && \
    apt-get install -y --no-install-recommends nodejs=20.19.0-1nodesource1 && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# .NET SDK (pinned) — Ubuntu 26.04 ships .NET natively in universe, so we no
# longer add the packages.microsoft.com feed (which doesn't carry 8.0 for 26.04
# anyway). The NuGet e2e only `dotnet restore`s a net8.0 fixture, which is
# framework-agnostic and resolves fine under the 10.0 SDK.
# ---------------------------------------------------------------------------
ARG DOTNET_VERSION=10.0
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        "dotnet-sdk-${DOTNET_VERSION}=10.0.109-0ubuntu1~26.04.*" \
    && rm -rf /var/lib/apt/lists/*

# Disable .NET telemetry in test environment
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

# ---------------------------------------------------------------------------
# Java + Maven (pinned)
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless=21.0.* \
        maven=3.9.12-* \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Ruby + Bundler (pinned)
# ---------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ruby=1:3.3build1 \
        ruby-dev=1:3.3build1 \
    && gem install bundler -v 2.5.6 --no-document \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Go (pinned with checksum) — this is a SEVENTH ADR-010 lockstep location,
# separate from the shdg-build stage's FROM golang:... above. It is a
# two-value bump: GO_VERSION and GO_SHA256 must change together, or the
# sha256sum -c below fails the build. Get the checksum from
# https://go.dev/dl/?mode=json (the linux-amd64 tarball entry) — never
# invent one. Keep in lockstep with go.mod's `go` directive, both Dockerfile
# builder images (docker/Dockerfile's `go-builder` stage and the `shdg-build`
# stage above — on those `FROM golang:<tag>@sha256:<digest>` lines the tag and
# the digest must move together, since Docker resolves by digest and a
# tag-only edit silently keeps the old image), and the three CI GO_VERSION
# values in .github/workflows/{ci,codeql,release}.yml. See ADR-010 for the
# authoritative seven-location list.
# ---------------------------------------------------------------------------
ARG GO_VERSION=1.27.1
ARG GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tar.gz && \
    echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# ---------------------------------------------------------------------------
# crane — OCI image tool for Docker E2E tests (pinned)
# ---------------------------------------------------------------------------
ARG CRANE_VERSION=0.19.1
RUN curl -fsSL "https://github.com/google/go-containerregistry/releases/download/v${CRANE_VERSION}/go-containerregistry_Linux_x86_64.tar.gz" \
    -o /tmp/crane.tar.gz && \
    tar -C /usr/local/bin -xzf /tmp/crane.tar.gz crane && \
    chmod +x /usr/local/bin/crane && \
    rm /tmp/crane.tar.gz

# ---------------------------------------------------------------------------
# shdg CLI — built in the shdg-build stage above
# ---------------------------------------------------------------------------
COPY --from=shdg-build /out/shdg /usr/local/bin/shdg
RUN chmod +x /usr/local/bin/shdg

# ---------------------------------------------------------------------------
# Copy test scripts
# ---------------------------------------------------------------------------
WORKDIR /tests
COPY tests/e2e-shell/ /tests/
RUN chmod +x /tests/*.sh

ENTRYPOINT ["/bin/bash"]
CMD ["./run_all.sh"]
